# Copy this file to .env and fill in your own values:  cp .env.example .env
# Never commit .env — it holds live tokens.

# Port for local development. Vercel sets this automatically.
PORT=3000

# ---- WhatsApp (Meta) ----
# developers.facebook.com -> your app -> WhatsApp -> API Setup
WHATSAPP_TOKEN=
PHONE_NUMBER_ID=

# Any random string you make up. You paste the SAME value into Meta's
# WhatsApp -> Configuration -> "Verify token" when registering the webhook.
VERIFY_TOKEN=

# Optional but recommended once the URL is public (Vercel): the App Secret from
# Meta -> App settings -> Basic. When set, every incoming webhook is checked
# against its X-Hub-Signature-256 header, so strangers cannot forge messages.
# Leave blank to skip signature checking.
WHATSAPP_APP_SECRET=

# ---- Groq (free LLM) ----
# console.groq.com -> API Keys
GROQ_API_KEY=

# Leave blank to use the default (llama-3.3-70b-versatile).
# Do NOT switch to a small model: llama-3.1-8b-instant and gpt-oss-20b drift
# into English and into Devanagari (Hindi) when asked for Urdu. The 70b model
# is the smallest that mirrors Urdu script reliably.
GROQ_MODEL=

# ---- Bot behaviour ----
# Up to 5 numbers, digits only: no "+", no spaces, comma-separated.
# A US number +1 415 555 2671 becomes 14155552671.
ALLOWED_NUMBERS=

# The bot's personality. Edit freely.
#
# Urdu and Roman Urdu need no configuration. lib/language.js detects the
# script of each incoming message and appends mirroring rules to whatever is
# written here, so editing SYSTEM_PROMPT changes the bot's character without
# ever removing its language support. Write the personality in any language.
SYSTEM_PROMPT=You are a friendly, helpful assistant chatting with a close contact over WhatsApp. Keep replies natural, conversational, and reasonably short (like a real text message), not overly formal.
