# Copy this file to .env and fill in your own key.
# Get one free at https://console.groq.com/keys
#
# Never commit .env, and never paste the key back into index.js — a key in a
# public repository is usable by anyone who finds it, and it stays in the git
# history forever even after you delete the line.
GROQ_API_KEY=

# Supabase database integration
SUPABASE_URL=
SUPABASE_KEY=
